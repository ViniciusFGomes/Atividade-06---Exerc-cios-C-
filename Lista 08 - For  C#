C)class Program//define uma classe chamada Program
{
    static void Main()//define o método Main, que é o ponto de entrada do programa
    {
        Console.Write("Digite uma palavra: ");//exibe uma mensagem solicitando ao usuário que digite uma palavra
        string palavra = Console.ReadLine();//lê a palavra digitada pelo usuário e armazena na variável "palavra"

        if (!string.IsNullOrWhiteSpace(palavra))//verifica se a palavra não é nula, vazia ou composta apenas por espaços em branco
        {
            Console.WriteLine("Letras da palavra:");//exibe uma mensagem indicando que as letras da palavra serão exibidas

            foreach (char letra in palavra)//itera sobre cada letra da palavra
            {
                Console.WriteLine(letra);//exibe cada letra da palavra em uma linha separada
            }
        }
        else//se a palavra for nula, vazia ou composta apenas por espaços em branco
        {
            Console.WriteLine("Nenhuma palavra foi digitada.");//exibe uma mensagem indicando que nenhuma palavra foi digitada
        }
    }
}
D)class Program//Define uma classe chamada "Program"
{
    static void Main()//Define o método principal "Main" que é o ponto de entrada do programa
    {
        Console.Write("Digite um número inteiro positivo: "); // Solicita ao usuário que insira um número inteiro positivo

        // Valida se a entrada é um número inteiro válido e maior que zero
        if (int.TryParse(Console.ReadLine(), out int numero) && numero > 0)
        {
            int soma = 0;// Inicializa a variável "soma" com zero

            for (int i = 1; i <= numero; i++)// Loop que percorre todos os números de 1 até o número inserido pelo usuário
            {
                soma += i;// Adiciona o valor de "i" à variável "soma"
            }

            Console.WriteLine("A soma de todos os números de 1 até "+numero+" é: "+soma);// Exibe o resultado da soma no console
        }
        else
        {
            Console.WriteLine("Entrada inválida. Por favor, insira um número inteiro positivo maior que zero.");// Exibe uma mensagem de erro caso a entrada seja inválida
        }
    }
}
E)class Program//Define uma classe chamada "Program"
{
    static void Main()//Define o método principal "Main" que é o ponto de entrada do programa
    {
        Console.Write("Digite um número inteiro: ");//Exibe uma mensagem solicitando ao usuário que digite um número inteiro
        int numero = int.Parse(Console.ReadLine());//Lê a entrada do usuário, converte para inteiro e armazena na variável "numero"
        bool primo = true;//Inicializa uma variável booleana "primo" como verdadeira, assumindo que o número é primo até que se prove o contrário
        if (numero < 2)//Verifica se o número é menor que 2, pois números menores que 2 não são primos
        {
            primo = false;//Se o número for menor que 2, define "primo" como falso
        }
        else//Se o número for 2 ou maior, verifica se ele é primo
        {
            for (int i = 2; i <= Math.Sqrt(numero); i++)//Inicia um loop que vai de 2 até a raiz quadrada do número
            {
                if (numero % i == 0)//Verifica se o número é divisível por "i"
                {
                    primo = false;//Se for divisível, define "primo" como falso, indicando que o número não é primo
                    break;//Sai do loop, pois já foi determinado que o número não é primo
                }
            }
        }
        if (primo)//Verifica o valor da variável "primo"
            Console.WriteLine("O número é primo.");//Se "primo" for verdadeiro, exibe uma mensagem indicando que o número é primo
        else//Se "primo" for falso, exibe uma mensagem indicando que o número não é primo
            Console.WriteLine("O número não é primo.");//Exibe uma mensagem indicando que o número não é primo
    }
}
F)class Program//define uma classe chamada Program
{
    static void Main()//define o método Main, que é o ponto de entrada do programa
    {
        Console.Write("Quantos números deseja inserir? ");//solicita ao usuário a quantidade de números que deseja inserir
        int quantidade = int.Parse(Console.ReadLine());//lê a quantidade de números inseridos pelo usuário e converte para inteiro

        int maior = int.MinValue;//inicializa a variável maior com o menor valor possível de um inteiro

        for (int i = 1; i <= quantidade; i++)//inicia um loop que se repete a quantidade de vezes especificada pelo usuário
        {
            Console.Write($"Digite o {i}º número: ");//solicita ao usuário que insira um número
            int numero = int.Parse(Console.ReadLine());//lê o número inserido pelo usuário e converte para inteiro

            if (numero > maior)//verifica se o número inserido é maior que o valor atual de maior
                maior = numero;//se for, atualiza o valor de maior com o novo número
        }
        Console.WriteLine("O maior número é: " + maior);//exibe o maior número encontrado
    }
}
