            soma += vetor[i];//adiciona o valor do elemento atual do array vetor à variável soma
        }
        double media = soma / vetor.Length;//calcula a média dos elementos do array vetor, dividindo a soma pelo número de elementos do array
        Console.WriteLine("Média = " + media);//imprime a média dos elementos do array vetor no console
    }
}
